{
  "name": "transformer_comprehensive_diagnosis",
  "task_type": "transformer_comprehensive_diagnosis",
  "steps": [
    {"id": "status", "kind": "tool", "tool": "prepare_status_data"},
    {"id": "three_ratio", "kind": "tool", "tool": "analyze_three_ratio"},
    {"id": "fault_tree", "kind": "tool", "tool": "evaluate_fault_tree"},
    {"id": "cases", "kind": "tool", "tool": "retrieve_similar_cases"},
    {"id": "assessment", "kind": "tool", "tool": "compose_comprehensive_assessment"},
    {"kind": "require", "path": "$steps.status.completed", "equals": true, "reason": "状态数据准备未完成。"},
    {"kind": "require", "path": "$steps.three_ratio.completed", "equals": true, "reason": "油色谱三比值诊断未完成。"},
    {"kind": "require", "path": "$steps.fault_tree.completed", "equals": true, "reason": "故障树诊断未完成。"},
    {"kind": "require", "path": "$steps.cases.completed", "equals": true, "reason": "相似案例检索未完成。"},
    {"kind": "require", "path": "$steps.assessment.consistent", "equals": true, "reason": "诊断证据存在冲突，应转人工复核。"}
  ],
  "output": {
    "status": "passed",
    "message": "$steps.assessment.message",
    "device_id": "$steps.status.device_id",
    "operation_state": "$steps.status.operation_state",
    "three_ratio_code": "$steps.three_ratio.three_ratio_code",
    "chromatography_result": "$steps.three_ratio",
    "fault_tree_result": "$steps.fault_tree",
    "similar_cases": "$steps.cases.similar_cases",
    "assessment": "$steps.assessment.assessment",
    "source_tools": ["prepare_status_data", "analyze_three_ratio", "evaluate_fault_tree", "retrieve_similar_cases", "compose_comprehensive_assessment"],
    "forbidden_commitments": ["设备操作", "自动处置"]
  }
}
