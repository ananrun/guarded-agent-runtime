{
  "provider_factory": "tools.configured_provider:create_provider",
  "data_file": "data.json",
  "tools": [
    {"name": "prepare_status_data", "operation": {"kind": "find", "source": "datasets.inspections", "match_argument": "inspection_id"}, "required_permission": "diagnosis:read", "schema": {"inspection_id": "str"}},
    {"name": "analyze_three_ratio", "operation": {"kind": "lookup", "source": "tool_results.three_ratio", "key": "{inspection_id}"}, "required_permission": "diagnosis:analyze", "schema": {"inspection_id": "str"}},
    {"name": "evaluate_fault_tree", "operation": {"kind": "lookup", "source": "tool_results.fault_tree", "key": "{inspection_id}"}, "required_permission": "diagnosis:analyze", "schema": {"inspection_id": "str"}},
    {"name": "retrieve_similar_cases", "operation": {"kind": "lookup", "source": "tool_results.case_retrieval", "key": "{inspection_id}"}, "required_permission": "diagnosis:read", "schema": {"inspection_id": "str"}},
    {"name": "compose_comprehensive_assessment", "operation": {"kind": "lookup", "source": "tool_results.assessment", "key": "{inspection_id}"}, "required_permission": "diagnosis:assess", "schema": {"inspection_id": "str"}}
  ]
}
