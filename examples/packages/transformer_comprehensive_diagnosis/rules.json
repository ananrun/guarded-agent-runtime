            "key_gas": {"gas": "C2H4", "finding": "乙烯占总烃比例较高，符合过热特征"},
            "generation_rate": {"period_days": 92, "C2H4_increase_ppm": "$derived.C2H4_increase_ppm", "C2H4_ppm_per_day": "$derived.C2H4_ppm_per_day", "finding": "乙烯持续上升，需缩短跟踪周期"}
          }
        }
      ],
