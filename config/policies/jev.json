{
  "enabled": true,
  "provider": "jevos_http",
  "base_url": "http://127.0.0.1:8017",
  "model": "jev-latest",
  "timeout_seconds": 3.0,
  "failure_mode": "deny",
  "human_review_risk_threshold": 0.55,
  "deny_risk_threshold": 0.9,
  "tool_call_gate": {
    "enabled": true
  },
  "output_review": {
    "enabled": true
  },
  "risky_tool_names": [
    "generate_audit_opinion",
    "approve_payment",
    "modify_budget",
    "modify_invoice"
  ],
  "risky_argument_phrases": [
    "已付款",
    "已提交付款",
    "付款完成",
    "打款",
    "修改预算",
    "预算调整",
    "修改发票",
    "全额报销"
  ],
  "risky_output_phrases": [
    "已付款",
    "已提交付款",
    "付款完成",
    "打款",
    "进入付款流程",
    "修改预算",
    "预算调整",
    "修改发票",
    "全额报销"
  ]
}
